# EmailJS Configuration (Free 200 emails/month client-side JavaScript library)
# 1. Sign up for free at https://www.emailjs.com/
# 2. Add Email Service (Connect your Gmail: ai.cloudranger@gmail.com) -> Copy Service ID
# 3. Create an Email Template -> Copy Template ID
# 4. Go to Account > API Keys -> Copy Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: Web3Forms Access Key (if you prefer Web3Forms)
# Get a free key at https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=
